# 비활성 예제: 비용 검토와 활성화 결정 후에만 .yml로 변경한다.
name: 공동 제작 검사

on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  check:
    name: 설치 및 코드 검증
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: 저장소 가져오기
        uses: actions/checkout@v7
        with:
          persist-credentials: false
      - name: Node.js 24 준비
        uses: actions/setup-node@v7
        with:
          node-version: '24'
          package-manager-cache: false
      - name: 잠금 파일대로 설치
        run: npm ci
      - name: 타입 검사
        run: npm run check
      - name: 물리 및 상태 테스트
        run: npm test
      - name: 배포 파일 생성
        run: npm run build
